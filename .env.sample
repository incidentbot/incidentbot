# Shared settings for all deployments
PLATFORM=slack
POSTGRES_HOST=
POSTGRES_DB=incident_bot
POSTGRES_USER=incident_bot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional Docker Compose overrides (uncomment as needed):
# COMPOSE_API_PORT=3000
# COMPOSE_POSTGRES_HOST=db
# COMPOSE_POSTGRES_DB=incident_bot
# COMPOSE_POSTGRES_USER=incident_bot
# COMPOSE_POSTGRES_PASSWORD=somepassword
# COMPOSE_POSTGRES_PORT=5432
# COMPOSE_POSTGRES_IMAGE_TAG=17
SECRET_KEY=change-me-to-a-stable-secret

# Optional: protect the REST API with a static key (X-Api-Key header)
# API_KEY=

# Set to true to serve Swagger UI at /api/v1/docs (local dev only)
# ENABLE_API_DOCS=true

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Slack-only settings (required when platform: slack)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...

# Matrix-only settings (required when platform: matrix)
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@incidentbot:example.com
MATRIX_ACCESS_TOKEN=syt_...
MATRIX_DEVICE_ID=INCIDENTBOT
MATRIX_DIGEST_ROOM_ID=!abcdef:example.com
MATRIX_WIDGET_BASE_URL=https://incidentbot.example.com

STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=

ATLASSIAN_API_URL=
ATLASSIAN_API_USERNAME=
ATLASSIAN_API_TOKEN=

PAGERDUTY_API_TOKEN=
PAGERDUTY_API_USERNAME=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

GITLAB_URL=
GITLAB_API_TOKEN=

PHARE_API_KEY=
PHARE_PROJECT_ID=
