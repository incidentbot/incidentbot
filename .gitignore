# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtualenvs
.venv
venv/
env/

# pyenv — pin Python via pyproject.toml and Dockerfile instead
.python-version

# Tool caches
.mypy_cache/
.ruff_cache/
.tox/

# Editors
.idea/
.DS_Store

# VS Code — keep settings.json (project Poetry config) but ignore personal overrides
.vscode/*
!.vscode/settings.json

# Secrets & local config
.env
*secret.json
*secret-sealed.json
config.yaml

# Docker dev stack (contains local credentials)
docker-compose.dev.yml

# Logs / scratch
logs/
tmp/
todo.md
test.py

# Elastic Beanstalk
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
